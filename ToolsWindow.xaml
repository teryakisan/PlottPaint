<Window x:Class="NVSPlotter.ToolsWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:fa="http://schemas.fontawesome.io/icons/"
Title="Tools"
Width="55" SizeToContent="Height"
WindowStyle="None"
ShowInTaskbar="False"
ResizeMode="NoResize"
Background="#FF121212"
AllowsTransparency="True"
WindowStartupLocation="Manual"
Closing="Window_Closing"
Loaded="Window_Loaded"
LocationChanged="Window_LocationChanged"
MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
<Window.Resources>
    <!-- Tool Button Style -->
    <Style x:Key="ToolButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Margin" Value="3,2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Foreground" Value="#E0E0E0"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4D4D4D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Selected">
                    <Setter Property="Background" Value="#0078D4"/>
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Separator Style -->
        <Style x:Key="ToolSeparatorStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#4D4D4D"/>
            <Setter Property="Margin" Value="6,4"/>
        </Style>
    </Window.Resources>
    
    <Border BorderBrush="#1D1D1D" BorderThickness="1" CornerRadius="4">
        <StackPanel>
            <!-- Header / Drag Handle -->
            <Border Background="#252525" Padding="0,4" CornerRadius="4,4,0,0">
                <fa:FontAwesome Icon="Wrench" FontSize="14" HorizontalAlignment="Center" Foreground="#808080"/>
            </Border>
            
            <!-- Tools -->
            <StackPanel x:Name="ToolsPanel" Margin="2,4,2,6">
                
                <!-- Selection & Navigation (most common) -->
                <Button x:Name="SelectBtn" Style="{StaticResource ToolButtonStyle}" 
                        ToolTip="Select / Transform (V)" Tag="Select" Click="ToolButton_Click">
                    <fa:FontAwesome Icon="MousePointer" Foreground="#E0E0E0" FontSize="20"/>
                </Button>
                
                <Button x:Name="PanBtn" Style="{StaticResource ToolButtonStyle}" 
                        ToolTip="Pan (H) - Middle mouse also works" Tag="Pan" Click="ToolButton_Click">
                    <fa:FontAwesome Icon="HandPaperOutline" Foreground="#E0E0E0" FontSize="20"/>
                </Button>
                
                <Button x:Name="ZoomBtn" Style="{StaticResource ToolButtonStyle}" 
                        ToolTip="Zoom (Z) - Drag up/down to zoom" Tag="Zoom" Click="ToolButton_Click">
                    <fa:FontAwesome Icon="Search" Foreground="#E0E0E0" FontSize="20"/>
                </Button>
                
                <Border Style="{StaticResource ToolSeparatorStyle}"/>
                
                <!-- Drawing Tools -->
                <Button x:Name="FreeDrawBtn" Style="{StaticResource ToolButtonStyle}" 
                        ToolTip="Free Draw (F) - Draw freehand strokes" Tag="FreeDraw" Click="ToolButton_Click">
                    <fa:FontAwesome Icon="Pencil" Foreground="#E0E0E0" FontSize="20"/>
                </Button>
                
                <Button x:Name="LineBtn" Style="{StaticResource ToolButtonStyle}" 
                        ToolTip="Line (L)" Tag="Line" Click="ToolButton_Click">
                    <fa:FontAwesome Icon="Minus" Foreground="#E0E0E0" FontSize="20" RenderTransformOrigin="0.5,0.5">
                        <fa:FontAwesome.RenderTransform>
                            <RotateTransform Angle="-45"/>
                        </fa:FontAwesome.RenderTransform>
                    </fa:FontAwesome>
                </Button>
                
                <Button x:Name="RectangleBtn" Style="{StaticResource ToolButtonStyle}" 
                        ToolTip="Rectangle (R)" Tag="Rectangle" Click="ToolButton_Click">
                    <fa:FontAwesome Icon="SquareOutline" Foreground="#E0E0E0" FontSize="20"/>
                </Button>
                
                <Button x:Name="CircleBtn" Style="{StaticResource ToolButtonStyle}" 
                        ToolTip="Circle (C) - Right-click for options" Tag="Circle" Click="ToolButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Circle Curve Segments" IsEnabled="False" FontWeight="Bold"/>
                            <Separator/>
                            <MenuItem Header="1 (Single curve)" Tag="1" Click="CircleSegments_Click"/>
                            <MenuItem Header="2 (Half circles)" Tag="2" Click="CircleSegments_Click"/>
                            <MenuItem Header="3 (Thirds)" Tag="3" Click="CircleSegments_Click"/>
                            <MenuItem Header="4 (Quarters)" Tag="4" Click="CircleSegments_Click"/>
                            <MenuItem Header="6 (Sixths)" Tag="6" Click="CircleSegments_Click"/>
                            <MenuItem Header="8 (Eighths)" Tag="8" Click="CircleSegments_Click"/>
                            <MenuItem Header="12 (Twelfths)" Tag="12" Click="CircleSegments_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <fa:FontAwesome Icon="CircleThin" Foreground="#E0E0E0" FontSize="20"/>
                </Button>
                
                <Button x:Name="PolylineBtn" Style="{StaticResource ToolButtonStyle}" 
                        ToolTip="Polyline (P)" Tag="Polyline" Click="ToolButton_Click">
                    <fa:FontAwesome Icon="ShareAlt" Foreground="#E0E0E0" FontSize="20"/>
                </Button>
                
                <Button x:Name="BezierBtn" Style="{StaticResource ToolButtonStyle}" 
                        ToolTip="Bezier Curve (B)" Tag="Bezier" Click="ToolButton_Click">
                    <fa:FontAwesome Icon="PencilSquareOutline" Foreground="#E0E0E0" FontSize="20"/>
                </Button>
                
                <Button x:Name="PolyBezierBtn" Style="{StaticResource ToolButtonStyle}" 
                        ToolTip="Poly-Bezier (Shift+B) - Connected curves" Tag="PolyBezier" Click="ToolButton_Click">
                    <fa:FontAwesome Icon="Sitemap" Foreground="#E0E0E0" FontSize="18"/>
                </Button>
                
                <Border Style="{StaticResource ToolSeparatorStyle}"/>
                
                <!-- Paint & Utility Tools -->
                <Button x:Name="PaintWellBtn" Style="{StaticResource ToolButtonStyle}" 
                        ToolTip="Paint Well (W)" Tag="PaintWell" Click="ToolButton_Click">
                    <fa:FontAwesome Icon="PaintBrush" Foreground="#E0E0E0" FontSize="20"/>
                </Button>
                
                <Button x:Name="MeasureBtn" Style="{StaticResource ToolButtonStyle}" 
                        ToolTip="Measure (M)" Tag="Measure" Click="ToolButton_Click">
                    <fa:FontAwesome Icon="Expand" Foreground="#E0E0E0" FontSize="20"/>
                </Button>
                
                <Button x:Name="EraseBtn" Style="{StaticResource ToolButtonStyle}" 
                        ToolTip="Erase (E)" Tag="Erase" Click="ToolButton_Click">
                    <fa:FontAwesome Icon="Eraser" Foreground="#E0E0E0" FontSize="20"/>
                </Button>
                
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
