<Window x:Class="NVSPlotter.Windows.MachineSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Machine Settings" 
        Width="420" Height="615"
        MinHeight="400" MinWidth="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Style="{DynamicResource ThemedWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Scrollable content area -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="15,15,15,5">
            <StackPanel>
                <!-- Bed Size Mode -->
                <GroupBox Header="Bed Size Configuration" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <RadioButton x:Name="AutoModeRadio" Content="Auto-detect from GRBL ($130/$131)" 
                                     GroupName="BedSizeMode" Margin="0,0,0,8"
                                     Checked="BedSizeMode_Changed"/>
                        <TextBlock Text="When connected, bed size is read from GRBL settings automatically." 
                                   FontSize="11" Foreground="Gray" Margin="20,0,0,10" TextWrapping="Wrap"/>
                        
                        <RadioButton x:Name="ManualModeRadio" Content="Manual configuration" 
                                     GroupName="BedSizeMode" Margin="0,0,0,8"
                                     Checked="BedSizeMode_Changed"/>
                        <TextBlock Text="Use custom bed dimensions (useful when not connected or GRBL lacks $130/$131)." 
                                   FontSize="11" Foreground="Gray" Margin="20,0,0,5" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <!-- Manual Bed Size -->
                <GroupBox Header="Bed Dimensions" Margin="0,0,0,10" x:Name="BedDimensionsGroup">
                    <StackPanel Margin="10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Width (X):" Width="80" VerticalAlignment="Center"/>
                            <TextBox x:Name="BedXBox" Width="100" Text="841"/>
                            <TextBlock Text="mm" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Height (Y):" Width="80" VerticalAlignment="Center"/>
                            <TextBox x:Name="BedYBox" Width="100" Text="1189"/>
                            <TextBlock Text="mm" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Presets -->
                        <TextBlock Text="Quick Presets:" Margin="0,8,0,5" FontWeight="SemiBold"/>
                        <WrapPanel>
                            <Button Content="A0 (841x1189)" Width="95" Margin="0,0,5,5" Click="PresetA0_Click"/>
                            <Button Content="A1 (594x841)" Width="95" Margin="0,0,5,5" Click="PresetA1_Click"/>
                            <Button Content="A2 (420x594)" Width="95" Margin="0,0,5,5" Click="PresetA2_Click"/>
                            <Button Content="A3 (297x420)" Width="95" Margin="0,0,5,5" Click="PresetA3_Click"/>
                            <Button Content="A4 (210x297)" Width="95" Margin="0,0,5,5" Click="PresetA4_Click"/>
                            <Button Content="24x36 in" Width="95" Margin="0,0,5,5" Click="Preset24x36_Click" ToolTip="609.6 x 914.4 mm"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Home Position -->
                <GroupBox Header="Home Position (when Manual mode)" Margin="0,0,0,10" x:Name="HomePositionGroup">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="HomeAtMaxXCheck" Content="X homes at max (right side)" Margin="0,0,0,8"/>
                        <CheckBox x:Name="HomeAtMaxYCheck" Content="Y homes at max (top side)" Margin="0,0,0,5"/>
                        <TextBlock Text="Most plotters (iDraw, AxiDraw) home at top-right." 
                                   FontSize="11" Foreground="Gray" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <!-- Current Status -->
                <GroupBox Header="Current Status" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="11"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons - always visible at bottom -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="15,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="80" Margin="0,0,10,0" Click="CancelBtn_Click" IsCancel="True"/>
                <Button Content="Apply" Width="80" Margin="0,0,10,0" Click="ApplyBtn_Click"/>
                <Button Content="OK" Width="80" Click="OkBtn_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
