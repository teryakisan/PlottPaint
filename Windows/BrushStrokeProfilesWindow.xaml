<Window x:Class="NVSPlotter.Windows.BrushStrokeProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NVSPlotter.Windows"
        xmlns:controls="clr-namespace:NVSPlotter.Controls"
        Title="Brush Stroke Profiles" Height="600" Width="800" WindowStartupLocation="CenterOwner"
        Style="{DynamicResource ThemedWindow}" Foreground="{DynamicResource RefForegroundBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Brush Stroke Profiles" FontSize="16" FontWeight="Bold" Margin="4" Foreground="{DynamicResource RefForegroundBrush}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <UniformGrid x:Name="ProfilesGrid" Columns="3" Rows="2" Margin="6" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <!-- cells will contain dotted border and curve editors -->
                <Border CornerRadius="4" Margin="6" Padding="6" SnapsToDevicePixels="True"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Background="{DynamicResource RefBackgroundBrush}">
                    <Grid>
                        <Rectangle StrokeDashArray="4 2" Stroke="{DynamicResource RefForegroundBrush}" StrokeThickness="1" RadiusX="4" RadiusY="4"/>
                        <controls:CurveEditor x:Name="CurveEditor0" Width="220" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- placeholder empty cells -->
                <Border CornerRadius="4" Margin="6" Padding="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource RefBackgroundBrush}">
                    <Grid>
                        <Rectangle StrokeDashArray="4 2" Stroke="{DynamicResource RefForegroundBrush}" StrokeThickness="1" RadiusX="4" RadiusY="4"/>
                        <TextBlock Text="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource RefForegroundBrush}"/>
                    </Grid>
                </Border>
                <Border CornerRadius="4" Margin="6" Padding="6" BorderBrush="Gray" BorderThickness="1" Background="#FFFFFFFF">
                    <Grid>
                        <Rectangle StrokeDashArray="4 2" Stroke="DarkGray" StrokeThickness="1" RadiusX="4" RadiusY="4"/>
                        <TextBlock Text="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                    </Grid>
                </Border>
                <Border CornerRadius="4" Margin="6" Padding="6" BorderBrush="Gray" BorderThickness="1" Background="#FFFFFFFF">
                    <Grid>
                        <Rectangle StrokeDashArray="4 2" Stroke="DarkGray" StrokeThickness="1" RadiusX="4" RadiusY="4"/>
                        <TextBlock Text="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                    </Grid>
                </Border>
                <Border CornerRadius="4" Margin="6" Padding="6" BorderBrush="Gray" BorderThickness="1" Background="#FFFFFFFF">
                    <Grid>
                        <Rectangle StrokeDashArray="4 2" Stroke="DarkGray" StrokeThickness="1" RadiusX="4" RadiusY="4"/>
                        <TextBlock Text="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                    </Grid>
                </Border>
                <Border CornerRadius="4" Margin="6" Padding="6" BorderBrush="Gray" BorderThickness="1" Background="#FFFFFFFF">
                    <Grid>
                        <Rectangle StrokeDashArray="4 2" Stroke="DarkGray" StrokeThickness="1" RadiusX="4" RadiusY="4"/>
                        <TextBlock Text="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                    </Grid>
                </Border>
            </UniformGrid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4">
            <Button x:Name="AddProfileBtn" Content="Add Profile" Width="100" Margin="6" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource RefForegroundBrush}"/>
            <Button x:Name="SaveProfileBtn" Content="Save Profile" Width="100" Margin="6" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource RefForegroundBrush}"/>
            <Button x:Name="CloseBtn" Content="Close" Width="100" Margin="6" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource RefForegroundBrush}"/>
        </StackPanel>
    </Grid>
</Window>
