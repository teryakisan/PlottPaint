<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ===== ANDROID-STYLE TOGGLE SWITCH ===== -->
    <!-- Based on ToggleButton, styled to look like a modern slide switch -->
    
    <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <!-- Track (background) -->
                        <Border x:Name="Track" 
                                Background="#E0E0E0" 
                                CornerRadius="11"
                                BorderThickness="0">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="2" Color="Black" Opacity="0.1" Direction="270"/>
                            </Border.Effect>
                        </Border>
                        
                        <!-- Thumb (the circular slider) -->
                        <Border x:Name="Thumb" 
                                Width="18" Height="18" 
                                CornerRadius="9"
                                Background="White"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="2,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="3" Color="Black" Opacity="0.3" Direction="270"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ThumbTranslate" X="0"/>
                            </Border.RenderTransform>
                        </Border>
                        
                        <!-- Hidden content for icon display -->
                        <Grid x:Name="IconContainer" Margin="6,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Sun icon (light mode) - shown when off -->
                            <TextBlock x:Name="SunIcon" Grid.Column="0"
									   FontFamily="Segoe UI Emoji"
                                       Text="☀" FontSize="10" 
                                       Foreground="#666666"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Visible"/>
                            
                            <!-- Moon icon (dark mode) - shown when on -->
                            <TextBlock x:Name="MoonIcon" Grid.Column="1" 
									   FontFamily="Segoe UI Emoji"
                                       Text="🌙" FontSize="10" 
                                       Foreground="Black"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                    
                    <ControlTemplate.Triggers>
                        <!-- Checked state (Dark Mode ON) -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#0078D4"/>
                            <Setter TargetName="SunIcon" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="MoonIcon" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                            Storyboard.TargetName="ThumbTranslate"
                                            Storyboard.TargetProperty="X"
                                            To="22" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                            Storyboard.TargetName="ThumbTranslate"
                                            Storyboard.TargetProperty="X"
                                            To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        
                        <!-- Hover state -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Background" Value="#F8F8F8"/>
                        </Trigger>
                        
                        <!-- Pressed state -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Thumb" Property="Width" Value="22"/>
                        </Trigger>
                        
                        <!-- Disabled state -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                            <Setter TargetName="Thumb" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- ===== DARK MODE AWARE TOGGLE SWITCH ===== -->
    <!-- This version adapts its off-state color based on the current theme -->
    
    <Style x:Key="ThemeToggleSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ToolTip" Value="Toggle Dark Mode"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <!-- Track (background) -->
                        <Border x:Name="Track" 
                                Background="#DAA520" 
                                CornerRadius="12"
                                BorderThickness="0">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="2" Color="Black" Opacity="0.15" Direction="270"/>
                            </Border.Effect>
                        </Border>
                        
                        <!-- Icons on track -->
                        <Grid Margin="5,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Sun icon (light mode indicator on left) -->
                            <TextBlock x:Name="SunIcon" Grid.Column="0" 
                                       Text="" FontSize="11" 
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0.8"/>
                            
                            <!-- Moon icon (dark mode indicator on right) -->
                            <TextBlock x:Name="MoonIcon" Grid.Column="1" 
                                       Text="" FontSize="11" 
                                       Foreground="#000000"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0.5"/>
                        </Grid>
                        
                        <!-- Thumb (the circular slider) -->
                        <Border x:Name="Thumb" 
                                Width="20" Height="20" 
                                CornerRadius="10"
                                Background="White"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="2,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Color="Black" Opacity="0.25" Direction="270"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ThumbTranslate" X="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    
                    <ControlTemplate.Triggers>
                        <!-- Checked state (Dark Mode ON) -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#1E3A5F"/>
                            <Setter TargetName="SunIcon" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="MoonIcon" Property="Opacity" Value="0.9"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                            Storyboard.TargetName="ThumbTranslate"
                                            Storyboard.TargetProperty="X"
                                            To="24" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                            Storyboard.TargetName="ThumbTranslate"
                                            Storyboard.TargetProperty="X"
                                            To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        
                        <!-- Hover state -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        
                        <!-- Pressed state - thumb gets wider like on mobile -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Thumb" Property="Width" Value="24"/>
                        </MultiTrigger>
                        
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Thumb" Property="Width" Value="24"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="-2,0,0,0"/>
                        </MultiTrigger>
                        
                        <!-- Disabled state -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                            <Setter TargetName="Thumb" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>
