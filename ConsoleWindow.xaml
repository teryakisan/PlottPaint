<Window x:Class="NVSPlotter.ConsoleWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="NVSPlotter Console" 
Width="500" Height="200"
MinWidth="300" MinHeight="100"
WindowStartupLocation="Manual"
Background="#111"
Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="ClearBtn" Content="Clear" Width="60" Click="ClearBtn_Click" Margin="0,0,10,0"/>
            <CheckBox x:Name="AutoScrollCheck" Content="Auto-scroll" IsChecked="True" 
                      Foreground="#D7D7D7" VerticalAlignment="Center"/>
        </StackPanel>
        
        <TextBox x:Name="ConsoleBox" Grid.Row="1"
                 Background="#111" Foreground="#D7D7D7"
                 FontFamily="Consolas"
                 FontSize="12"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
