<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:Models="clr-namespace:NVSPlotter.Models" x:Name="MainContainerWindow" x:Class="NVSPlotter.MainWindow"
        Title="NVSPlotter" Width="1280" Height="807"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown" Background="{x:Null}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="0,0,1,0" Background="#FAFAFA">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-1,0">
                <StackPanel Margin="10" Orientation="Vertical">

                    <GroupBox x:Name="Document" Header="Document" Margin="0,0,0,10">

                        <Expander Header="Settings" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <StackPanel x:Name="Page" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Page:" Width="90" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="PagePresetCombo" Width="203" SelectionChanged="PagePresetCombo_SelectionChanged">
                                        <ComboBoxItem Content="A0 Portrait (841 x 1189 mm)" IsSelected="True"/>
                                        <ComboBoxItem Content="A0 Landscape (1189 x 841 mm)"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel x:Name="HomeCornere" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Home Corner:" Width="90" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="HomeCornerCombo" Width="203">
                                        <ComboBoxItem Content="Top Right (common iDraw)" IsSelected="True"/>
                                        <ComboBoxItem Content="Top Left"/>
                                        <ComboBoxItem Content="Bottom Right"/>
                                        <ComboBoxItem Content="Bottom Left"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel x:Name="Tools" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                                    <!-- Tool selection moved to floating Tools panel -->
                                    <TextBlock Text="Tool:" Width="110" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ToolCombo" Width="203" SelectedValuePath="Tag" SelectionChanged="ToolCombo_SelectionChanged">
                                        <ComboBoxItem Content="Paint Well Tool" Tag="PaintWell"  IsSelected="True"/>
                                        <ComboBoxItem Content="Line" Tag="Line"/>
                                        <ComboBoxItem Content="Pan (Middle Mouse also works)" Tag="Pan"/>
                                        <ComboBoxItem Content="Zoom Tool" Tag="Zoom"/>
                                        <ComboBoxItem Content="Rectangle Tool" Tag="Rectangle"/>
                                        <ComboBoxItem Content="Circle Tool" Tag="Circle"/>
                                        <ComboBoxItem Content="Polyline Tool" Tag="Polyline"/>
                                        <ComboBoxItem Content="Bezier Tool" Tag="Bezier"/>
                                        <ComboBoxItem Content="Erase Tool" Tag="Erase"/>
                                        <ComboBoxItem Content="Measurement Tool" Tag="Measure"/>
                                        <ComboBoxItem Content="Guides / Grid Tool" Tag="Guides"/>
                                        <ComboBoxItem Content="Text / Annotation Tool" Tag="Text"/>
                                        <ComboBoxItem Content="Selection / Transform Tool" Tag="Select"/>
                                        <ComboBoxItem Content="Crop / Mask Tool" Tag="Crop"/>
                                        <ComboBoxItem Content="Image Alignment Tool" Tag="ImageAlign"/>
                                        
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel x:Name="SnapSettings" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Snap:" Width="68" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="SnapEnabledCheck" Content="Endpoints" IsChecked="True" VerticalAlignment="Center"/>
                                    <TextBlock Text="Radius:" Margin="15,0,5,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SnapRadiusBox" Width="40" Text="5" VerticalAlignment="Center"/>
                                    <TextBlock Text="mm" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel x:Name="GridSettings" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Grid:" Width="68" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ShowGridCheck" Content="Show" IsChecked="True" VerticalAlignment="Center" Click="ShowGridCheck_Click"/>
                                    <CheckBox x:Name="SnapToGridCheck" Content="Snap" IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Text="Size:" Margin="10,0,5,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="GridSpacingBox" Width="35" Text="5" VerticalAlignment="Center" TextChanged="GridSpacingBox_TextChanged"/>
                                    <TextBlock Text="mm" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel x:Name="MeasurementOut" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Measure:" Width="90" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MeasurementStatus" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#555" Text="—"/>
                                </StackPanel>

                                <StackPanel x:Name="WorkingArea" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Working area:" Width="90" VerticalAlignment="Center"/>
                                    <Button x:Name="DefineWorkingAreaBtn" Content="Define" Width="103" Click="DefineWorkingAreaBtn_Click"/>
                                    <Button x:Name="ClearWorkingAreaBtn" Content="Clear" Width="90" Margin="8,0,0,0" Click="ClearWorkingAreaBtn_Click"/>

                                </StackPanel>

                                <StackPanel x:Name="status" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock x:Name="WorkingAreaStatus" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#555"/>
                                </StackPanel>
                                <StackPanel x:Name="RefZoom" Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Zoom:" Width="90" VerticalAlignment="Center"/>
                                    <!-- NOTE: no ValueChanged handler here on purpose -->
                                    <Slider x:Name="ZoomSlider" Minimum="0.1" Maximum="4.0" Value="0.6"
                                            Width="150" ValueChanged="ZoomSlider_ValueChanged"/>
                                    <TextBlock x:Name="ZoomLabel" Width="60" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <WrapPanel x:Name="RefCUFR90" Orientation="Horizontal" >
                                    <Button x:Name="ClearBtn" Content="Clear" Width="55" Click="ClearBtn_Click"/>
                                    <Button x:Name="UndoBtn" Content="Undo" Width="55" Click="UndoBtn_Click"/>
                                    <Button x:Name="FitBtn" Content="Fit" Width="77" Click="FitBtn_Click"/>
                                    <Button x:Name="RotateCanvasBtn" Content="Rotate 90°" Width="101" Click="RotateCanvasBtn_Click" Height="30"/>
                                </WrapPanel>


                            </StackPanel>
                        </Expander>

                    </GroupBox>
                    <!-- PAINT WELLS / PAINTING MODE -->
                    <GroupBox x:Name="PaintWellsGroup" Header="🎨 Painting Mode" Margin="0,0,0,10">
                        <Expander Header="Paint Wells" IsExpanded="True">
                            <StackPanel Margin="10">
                                <!-- Enable/Disable Painting Mode -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox x:Name="PaintModeEnabledCheck" Content="Enable Painting Mode" 
                               IsChecked="False" VerticalAlignment="Center" 
                               Click="PaintModeEnabledCheck_Click"/>
                                </StackPanel>

                                <!-- Auto Wash/Wipe on Color Change -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox x:Name="AutoWashWipeCheck" Content="Auto Wash/Wipe on color change" 
                               IsChecked="True" VerticalAlignment="Center" 
                               ToolTip="Automatically rinse and wipe brush when changing colors"/>
                                </StackPanel>

                                <!-- Active Paint Color Selection -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Active Color:" Width="80" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ActivePaintWellCombo" Width="140" 
                               SelectionChanged="ActivePaintWellCombo_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle Width="16" Height="16" Margin="0,0,8,0"
                                                Stroke="Gray" StrokeThickness="1">
                                                        <Rectangle.Fill>
                                                            <SolidColorBrush Color="{Binding Color}"/>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Content="None" Width="50" Margin="5,0,0,0" 
                             Click="ClearActivePaintWell_Click" ToolTip="Clear active paint (use black)"/>
                                </StackPanel>

                                <!-- Paint Wells List -->
                                <TextBlock Text="Paint Wells:" Margin="0,5,0,3" FontWeight="SemiBold"/>
                                <ListBox x:Name="PaintWellsList" Height="100" Margin="0,0,0,8"
                          SelectionChanged="PaintWellsList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="20" Height="20" Margin="0,0,8,0"
                                            Stroke="DarkGray" StrokeThickness="1">
                                                    <Rectangle.Fill>
                                                        <SolidColorBrush Color="{Binding Color}"/>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Width="100"/>
                                                <TextBlock Text="{Binding DipDepth, StringFormat='Dip: {0:0.#}mm'}" 
                                            VerticalAlignment="Center" Foreground="Gray" FontSize="10"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Paint Well Actions -->
                                <WrapPanel Margin="0,0,0,8">
                                    <Button x:Name="AddPaintWellBtn" Content="Add Well" Width="70" Margin="0,0,5,0" 
                             Click="AddPaintWellBtn_Click" ToolTip="Select PaintWell tool and draw on canvas"/>
                                    <Button x:Name="RemovePaintWellBtn" Content="Remove" Width="60" Margin="0,0,5,0" 
                             Click="RemovePaintWellBtn_Click"/>
                                    <Button x:Name="ClearPaintWellsBtn" Content="Clear All" Width="60" 
                             Click="ClearPaintWellsBtn_Click"/>
                                </WrapPanel>

                                <!-- Quick Setup -->
                                <Button x:Name="QuickSetupPaintWellsBtn" Content="🎨 Quick Setup" 
                         Margin="0,0,0,8" Click="QuickSetupPaintWellsBtn_Click"
                         ToolTip="Create Red, Green, Blue, Wash (black), and Wipe (gray) paint wells automatically"/>

                                <!-- Selected Well Properties -->
                                <Border BorderBrush="#CCC" BorderThickness="1" Padding="8" Margin="0,5,0,0"
                         Visibility="{Binding ElementName=PaintWellsList, Path=SelectedItem, Converter={StaticResource NullToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="Selected Well Properties:" FontWeight="SemiBold" Margin="0,0,0,5"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="Name:" Width="70" VerticalAlignment="Center"/>
                                            <TextBox x:Name="PaintWellNameBox" Width="150" 
                                      TextChanged="PaintWellNameBox_TextChanged"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="Color:" Width="70" VerticalAlignment="Center"/>
                                            <Rectangle x:Name="PaintWellColorPreview" Width="24" Height="24" 
                                        Stroke="Gray" StrokeThickness="1" Margin="0,0,8,0"
                                        MouseLeftButtonDown="PaintWellColorPreview_Click" Cursor="Hand"/>
                                            <Button Content="Pick Color" Width="80" Click="PaintWellColorPreview_Click"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="Dip Depth:" Width="70" VerticalAlignment="Center"/>
                                            <TextBox x:Name="PaintWellDipDepthBox" Width="60" 
                                      TextChanged="PaintWellDipDepthBox_TextChanged"/>
                                            <TextBlock Text="mm" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="Dwell Time:" Width="70" VerticalAlignment="Center"/>
                                            <TextBox x:Name="PaintWellDwellBox" Width="60" 
                                      TextChanged="PaintWellDwellBox_TextChanged"/>
                                            <TextBlock Text="ms" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="Refresh:" Width="70" VerticalAlignment="Center"/>
                                            <TextBox x:Name="PaintWellRefreshMinBox" Width="40" 
                                      TextChanged="PaintWellRefreshMinBox_TextChanged"
                                      ToolTip="Minimum distance before paint refresh"/>
                                            <TextBlock Text="-" Margin="3,0,3,0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="PaintWellRefreshMaxBox" Width="40" 
                                      TextChanged="PaintWellRefreshMaxBox_TextChanged"
                                      ToolTip="Maximum distance before paint refresh"/>
                                            <TextBlock Text="mm" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="10"/>
                                        </StackPanel>

                                        <Button Content="Apply Color to Selection" Margin="0,5,0,0" 
                                 Click="ApplyPaintToSelection_Click"
                                 ToolTip="Apply this paint well's color to selected strokes"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </GroupBox>
                    <GroupBox x:Name="ReferenceImage" Header="Reference Image" Margin="0,0,0,10">
                        <StackPanel>
                            <Expander Header="Settings">
                                <StackPanel Margin="10">
                                    <StackPanel x:Name="Reference" Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Reference:" Width="90" VerticalAlignment="Center"/>
                                        <Button x:Name="ImportImageBtn" Content="Import image" Width="79" Click="ImportImageBtn_Click"/>
                                        <Button x:Name="ClearImageBtn" Content="Remove" Width="53" Margin="8,0,0,0" Click="ClearImageBtn_Click"/>
                                        <CheckBox x:Name="ImageLockCheck" Content="Lock" Margin="8,0,0,0" VerticalAlignment="Center" Click="ImageLockCheck_Click"/>
                                    </StackPanel>

                                    <StackPanel x:Name="RefRotation" Orientation="Horizontal" Width="307" HorizontalAlignment="Left" Margin="0,0,0,5">
                                        <TextBlock Text="Rotation:" Width="90" VerticalAlignment="Center"/>
                                        <Slider x:Name="ImageRotateSlider" Minimum="-180" Maximum="180" Value="0" Width="93"
                                            ValueChanged="ImageRotateSlider_ValueChanged"/>
                                        <TextBlock x:Name="ImageRotateValue" Width="40" Margin="10,0,0,0" VerticalAlignment="Center" Text="0°"/>
                                        <Button x:Name="ImageRotateResetBtn" Content="Reset" Width="50" Margin="8,0,0,0" Click="ImageRotateResetBtn_Click"/>
                                    </StackPanel>

                                    <StackPanel x:Name="RefImageFilter" Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Image filter:" Width="90" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="ImageFilterCombo" Width="203" SelectedValuePath="Tag" SelectionChanged="ImageFilterCombo_SelectionChanged" IsEnabled="False">
                                            <ComboBoxItem Content="None" Tag="None" IsSelected="True"/>
                                            <ComboBoxItem Content="Grayscale" Tag="Grayscale"/>
                                            <ComboBoxItem Content="Sepia" Tag="Sepia"/>
                                            <ComboBoxItem Content="Invert" Tag="Invert"/>
                                            <ComboBoxItem Content="High Contrast" Tag="HighContrast"/>
                                            <Separator />
                                            <ComboBoxItem Content="BrightnessUp" Tag="BrightnessUp"/>
                                            <ComboBoxItem Content="BrightnessDown" Tag="BrightnessDown"/>
                                            <Separator/>
                                            <ComboBoxItem Content="ContrastBoost" Tag="ContrastBoost"/>
                                            <ComboBoxItem Content="ContrastReduce" Tag="ContrastReduce"/>
                                            <Separator/>
                                            <ComboBoxItem Content="Gamma22" Tag="Gamma22"/>
                                            <ComboBoxItem Content="Gamma08" Tag="Gamma08"/>
                                            <Separator/>
                                            <ComboBoxItem Content="Threshold128" Tag="Threshold128"/>
                                            <ComboBoxItem Content="Solarize" Tag="Solarize"/>
                                            <ComboBoxItem Content="Posterize6" Tag="Posterize6"/>
                                            <Separator/>
                                            <ComboBoxItem Content="Warm" Tag="Warm"/>
                                            <ComboBoxItem Content="Cool" Tag="Cool"/>
                                            <Separator/>
                                            <ComboBoxItem Content="NightVision" Tag="NightVision"/>
                                            <ComboBoxItem Content="RedOnly" Tag="RedOnly"/>
                                            <ComboBoxItem Content="GreenOnly" Tag="GreenOnly"/>
                                            <ComboBoxItem Content="BlueOnly" Tag="BlueOnly"/>
                                            <Separator/>
                                            <ComboBoxItem Content="SwapRB" Tag="SwapRB"/>
                                            <ComboBoxItem Content="TintRed" Tag="TintRed"/>
                                            <ComboBoxItem Content="TintCyan" Tag="TintCyan"/>
                                            <Separator/>
                                            <ComboBoxItem Content="BoxBlur3" Tag="BoxBlur3"/>
                                            <ComboBoxItem Content="GaussianBlur5" Tag="GaussianBlur5"/>
                                            <ComboBoxItem Content="Sharpen" Tag="Sharpen"/>
                                            <ComboBoxItem Content="Emboss" Tag="Emboss"/>
                                            <ComboBoxItem Content="SobelEdge" Tag="SobelEdge"/>
                                            <ComboBoxItem Content="ReverseSobelEdge" Tag="ReverseSobelEdge"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <Slider x:Name="FilterControlSlider" TickFrequency="1" IsSnapToTickEnabled="True" Maximum="255" Minimum="1" TickPlacement="TopLeft" ValueChanged="FilterControlSlider_ValueChanged" Width="234" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="G_Code" Header="G-code" Margin="0,0,0,10">
                        <Expander Header="Settings" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <StackPanel x:Name="XYFeed" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="XY Feed:" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="FeedXYBox" Width="148" Text="3000"/>
                                    <TextBlock Text="mm/min" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel x:Name="ZUp" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Z Up:" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ZUpBox" Width="173" Text="10"/>
                                    <TextBlock Text="mm" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel x:Name="ZDown" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Z Down:" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ZDownBox" Width="173" Text="2"/>
                                    <TextBlock Text="mm" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel x:Name="SafeMarginSetting" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Safe Margin:" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SafeMarginBox" Width="60" Text="50" TextChanged="SafeMarginBox_TextChanged"/>
                                    <TextBlock Text="mm" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ShowMarginOverlayCheck" Content="Show" IsChecked="True" 
                                              Margin="10,0,0,0" VerticalAlignment="Center" Click="ShowMarginOverlayCheck_Click"/>
                                </StackPanel>

                                <CheckBox x:Name="OptimizeCheck" Content="Optimize stroke order"
                                      IsChecked="False" Margin="0,0,0,10"/>

                                <StackPanel x:Name="GCode_Export_Tools" Orientation="Horizontal">
                                    <Button x:Name="ExportBtn" Content="Export .gcode" Width="138" Margin="0,0,10,0" Click="ExportBtn_Click"/>
                                    <Button x:Name="CopyBtn" Content="Copy G-code" Width="145" Click="CopyBtn_Click"/>
                                </StackPanel>

                                <StackPanel x:Name="Start_End_Panel" Margin="10" Width="298" HorizontalAlignment="Left">
                                    <StackPanel x:Name="Start_Panel" Orientation="Horizontal" Margin="0,0,0,8" HorizontalAlignment="Left" Width="283">
                                        <TextBlock Width="33" VerticalAlignment="Top" Height="15"><Run Text="Start:"/><LineBreak/><Run/></TextBlock>
                                        <TextBox x:Name="StartGcodeBox" Width="250" Height="60" TextWrapping="Wrap"
                  AcceptsReturn="True"
                  VerticalScrollBarVisibility="Auto"
                  Text="G21 ; Set units to mm&#xA;G90 ; Absolute positioning&#xA;G94 ; Set feed rate mode to mm/min" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel x:Name="End_Panel" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="End:" Width="33" VerticalAlignment="Top"/>
                                        <TextBox x:Name="EndGcodeBox" Width="250" Height="60" TextWrapping="Wrap"
                  AcceptsReturn="True"
                  VerticalScrollBarVisibility="Auto"
                  Text="G0 Z10 ; Raise Z axis&#xA;G0 X0 Y0 ; Return to home" FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                        </Expander>
                    </GroupBox>



                    <GroupBox x:Name="Plotter" Header="Plotter (GRBL)" Margin="0,0,0,10">
                        <Expander Header="Settings">
                            <StackPanel Margin="10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Port:" Width="90" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="PortCombo" Width="113"/>
                                    <Button Content="↻" Width="82" Margin="8,0,0,0" Click="RefreshPortsBtn_Click"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Baud:" Width="90" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="BaudCombo" Width="113">
                                        <ComboBoxItem Content="115200" IsSelected="True"/>
                                        <ComboBoxItem Content="250000"/>
                                    </ComboBox>
                                    <Button x:Name="ConnectBtn" Content="Connect" Width="82" Margin="8,0,0,0" Click="ConnectBtn_Click"/>
                                </StackPanel>

                                <WrapPanel Margin="0,0,0,10" Width="328">
                                    <Button Content="Auto Home ($H)" Width="178" Margin="0,0,8,8" Click="HomeBtn_Click"/>
                                    <Button Content="$X Unlock" Width="107" Margin="0,0,8,8" Click="UnlockBtn_Click"/>
                                    <Button Content="Reset" Width="178" Margin="0,0,8,8" Click="ResetBtn_Click"/>
                                    <Button x:Name="SendBtn" Content="Send G-code" Width="107" Margin="0,0,8,8" Click="SendBtn_Click"/>
                                    <Button x:Name="StopBtn" Content="Stop" Width="293" Margin="0,0,8,8" Click="StopBtn_Click"/>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Height="96">
                                    <TextBox x:Name="ManualCmdBox" Width="238" Margin="0,0,8,0"
                                         ToolTip="Send a single GRBL line, e.g. G0 X10 Y10" Height="91" VerticalAlignment="Top"/>
                                    <Button Content="Send" Width="42" Click="ManualSendBtn_Click" Height="24"/>
                                </StackPanel>

                                <TextBlock x:Name="ConnStatusLabel" Margin="0,10,0,0" Foreground="#444"/>
                            </StackPanel>
                        </Expander>

                    </GroupBox>

               


                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- RIGHT PANEL -->
        <Grid Grid.Column="1">
            <!-- CANVAS AREA -->
            <Border Background="#EEE">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#F0F0F0" Height="28">
                        <Button x:Name="NewProjectBtn" Content="📄 New" Width="60" Margin="5,2" Click="NewProjectBtn_Click" ToolTip="New Project (Ctrl+N)"/>
                        <Button x:Name="OpenProjectBtn" Content="📂 Open" Width="65" Margin="0,2" Click="OpenProjectBtn_Click" ToolTip="Open Project (Ctrl+O)"/>
                        <Button x:Name="SaveProjectBtn" Content="💾 Save" Width="60" Margin="0,2" Click="SaveProjectBtn_Click" ToolTip="Save Project (Ctrl+S)"/>
                        <Button x:Name="SaveAsProjectBtn" Content="Save As" Width="55" Margin="0,2" Click="SaveAsProjectBtn_Click" ToolTip="Save Project As (Ctrl+Shift+S)"/>
                        <Separator Width="1" Background="#CCC" Margin="5,4"/>
                        <Button x:Name="ShowConsoleBtn" Content="📋 Console" Width="80" Margin="5,2" Click="ShowConsoleBtn_Click" ToolTip="Show/Hide Console Window"/>
                    </StackPanel>
                    
                    <ScrollViewer x:Name="CanvasScroll" Grid.Row="1"
                      SizeChanged="CanvasScroll_SizeChanged"
                      HorizontalScrollBarVisibility="Visible"
                      VerticalScrollBarVisibility="Visible">
                        <Grid x:Name="CanvasHost" Background="Transparent">
                            <Canvas x:Name="DrawCanvas" Background="Transparent"
                    MouseWheel="DrawCanvas_MouseWheel"
                    MouseDown="DrawCanvas_MouseDown"
                    MouseUp="DrawCanvas_MouseUp"
                    MouseMove="DrawCanvas_MouseMove"
                    MouseLeave="DrawCanvas_MouseLeave"
                    MouseRightButtonDown="DrawCanvas_MouseRightButtonDown"
                    MouseLeftButtonDown="DrawCanvas_MouseLeftButtonDown"
                    MouseLeftButtonUp="DrawCanvas_MouseLeftButtonUp"/>
                            <Canvas x:Name="RulerCanvas" IsHitTestVisible="False" Panel.ZIndex="10"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
