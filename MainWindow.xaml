<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:Models="clr-namespace:NVSPlotter.Models" x:Name="MainContainerWindow" x:Class="NVSPlotter.MainWindow"
        Title="NVSPlotter" Width="1280" Height="807"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown" Background="{x:Null}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="0,0,1,0" Background="#FAFAFA">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-1,0">
                <StackPanel Margin="10" Orientation="Vertical">

                    <GroupBox x:Name="Document" Header="Document" Margin="0,0,0,10">

                        <Expander Header="Settings" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <StackPanel x:Name="Page" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Page:" Width="90" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="PagePresetCombo" Width="190" SelectionChanged="PagePresetCombo_SelectionChanged">
                                        <ComboBoxItem Content="A0 Portrait (841 x 1189 mm)" IsSelected="True"/>
                                        <ComboBoxItem Content="A0 Landscape (1189 x 841 mm)"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel x:Name="HomeCornere" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Home Corner:" Width="90" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="HomeCornerCombo" Width="190">
                                        <ComboBoxItem Content="Top Right (common iDraw)" IsSelected="True"/>
                                        <ComboBoxItem Content="Top Left"/>
                                        <ComboBoxItem Content="Bottom Right"/>
                                        <ComboBoxItem Content="Bottom Left"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel x:Name="Tools" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Tool:" Width="90" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ToolCombo" Width="190" SelectedValuePath="Tag" SelectionChanged="ToolCombo_SelectionChanged">
                                        <ComboBoxItem Content="Line" Tag="Line" IsSelected="True"/>
                                        <ComboBoxItem Content="Pan (Middle Mouse also works)" Tag="Pan"/>
                                        <ComboBoxItem Content="Rectangle Tool" Tag="Rectangle"/>
                                        <ComboBoxItem Content="Circle Tool" Tag="Circle"/>
                                        <ComboBoxItem Content="Polyline Tool" Tag="Polyline"/>
                                        <ComboBoxItem Content="Bezier Tool" Tag="Bezier"/>
                                        <ComboBoxItem Content="Erase Tool" Tag="Erase"/>
                                        <ComboBoxItem Content="Measurement Tool" Tag="Measure"/>
                                        <ComboBoxItem Content="Guides / Grid Tool" Tag="Guides"/>
                                        <ComboBoxItem Content="Text / Annotation Tool" Tag="Text"/>
                                        <ComboBoxItem Content="Selection / Transform Tool" Tag="Select"/>
                                        <ComboBoxItem Content="Crop / Mask Tool" Tag="Crop"/>
                                        <ComboBoxItem Content="Image Alignment Tool" Tag="ImageAlign"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel x:Name="MeasurementOut" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Measure:" Width="90" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MeasurementStatus" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#555" Text="—"/>
                                </StackPanel>

                                <StackPanel x:Name="WorkingArea" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Working area:" Width="90" VerticalAlignment="Center"/>
                                    <Button x:Name="DefineWorkingAreaBtn" Content="Define" Width="90" Click="DefineWorkingAreaBtn_Click"/>
                                    <Button x:Name="ClearWorkingAreaBtn" Content="Clear" Width="90" Margin="8,0,0,0" Click="ClearWorkingAreaBtn_Click"/>

                                </StackPanel>

                                <StackPanel x:Name="status" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock x:Name="WorkingAreaStatus" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#555"/>
                                </StackPanel>
                                <StackPanel x:Name="RefZoom" Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Zoom:" Width="90" VerticalAlignment="Center"/>
                                    <!-- NOTE: no ValueChanged handler here on purpose -->
                                    <Slider x:Name="ZoomSlider" Minimum="0.1" Maximum="4.0" Value="1.0"
                                            Width="150" ValueChanged="ZoomSlider_ValueChanged"/>
                                    <TextBlock x:Name="ZoomLabel" Width="60" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <WrapPanel x:Name="RefCUFR90" Orientation="Horizontal" >
                                    <Button x:Name="ClearBtn" Content="Clear" Width="55" Click="ClearBtn_Click"/>
                                    <Button x:Name="UndoBtn" Content="Undo" Width="55" Click="UndoBtn_Click"/>
                                    <Button x:Name="FitBtn" Content="Fit" Width="77" Click="FitBtn_Click"/>
                                    <Button x:Name="RotateCanvasBtn" Content="Rotate 90°" Width="95" Click="RotateCanvasBtn_Click" Height="30"/>
                                </WrapPanel>


                            </StackPanel>
                        </Expander>

                    </GroupBox>
                    <GroupBox x:Name="ReferenceImage" Header="Reference Image" Margin="0,0,0,10">
                        <StackPanel>
                            <Expander Header="Settings">
                                <StackPanel Margin="10">
                                    <StackPanel x:Name="Reference" Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Reference:" Width="90" VerticalAlignment="Center"/>
                                        <Button x:Name="ImportImageBtn" Content="Import image" Width="79" Click="ImportImageBtn_Click"/>
                                        <Button x:Name="ClearImageBtn" Content="Remove" Width="53" Margin="8,0,0,0" Click="ClearImageBtn_Click"/>
                                        <CheckBox x:Name="ImageLockCheck" Content="Lock" Margin="8,0,0,0" VerticalAlignment="Center" Click="ImageLockCheck_Click"/>
                                    </StackPanel>

                                    <StackPanel x:Name="RefRotation" Orientation="Horizontal" Width="307" HorizontalAlignment="Left" Margin="0,0,0,5">
                                        <TextBlock Text="Rotation:" Width="90" VerticalAlignment="Center"/>
                                        <Slider x:Name="ImageRotateSlider" Minimum="-180" Maximum="180" Value="0" Width="107"
                                            ValueChanged="ImageRotateSlider_ValueChanged"/>
                                        <TextBlock x:Name="ImageRotateValue" Width="40" Margin="10,0,0,0" VerticalAlignment="Center" Text="0°"/>
                                        <Button x:Name="ImageRotateResetBtn" Content="Reset" Width="50" Margin="8,0,0,0" Click="ImageRotateResetBtn_Click"/>
                                    </StackPanel>

                                    <StackPanel x:Name="RefImageFilter" Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Image filter:" Width="90" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="ImageFilterCombo" Width="190" SelectedValuePath="Tag" SelectionChanged="ImageFilterCombo_SelectionChanged" IsEnabled="False">
                                            <ComboBoxItem Content="None" Tag="None" IsSelected="True"/>
                                            <ComboBoxItem Content="Grayscale" Tag="Grayscale"/>
                                            <ComboBoxItem Content="Sepia" Tag="Sepia"/>
                                            <ComboBoxItem Content="Invert" Tag="Invert"/>
                                            <ComboBoxItem Content="High Contrast" Tag="HighContrast"/>
                                            <Separator />
                                            <ComboBoxItem Content="BrightnessUp" Tag="BrightnessUp"/>
                                            <ComboBoxItem Content="BrightnessDown" Tag="BrightnessDown"/>
                                            <Separator/>
                                            <ComboBoxItem Content="ContrastBoost" Tag="ContrastBoost"/>
                                            <ComboBoxItem Content="ContrastReduce" Tag="ContrastReduce"/>
                                            <Separator/>
                                            <ComboBoxItem Content="Gamma22" Tag="Gamma22"/>
                                            <ComboBoxItem Content="Gamma08" Tag="Gamma08"/>
                                            <Separator/>
                                            <ComboBoxItem Content="Threshold128" Tag="Threshold128"/>
                                            <ComboBoxItem Content="Solarize" Tag="Solarize"/>
                                            <ComboBoxItem Content="Posterize6" Tag="Posterize6"/>
                                            <Separator/>
                                            <ComboBoxItem Content="Warm" Tag="Warm"/>
                                            <ComboBoxItem Content="Cool" Tag="Cool"/>
                                            <Separator/>
                                            <ComboBoxItem Content="NightVision" Tag="NightVision"/>
                                            <ComboBoxItem Content="RedOnly" Tag="RedOnly"/>
                                            <ComboBoxItem Content="GreenOnly" Tag="GreenOnly"/>
                                            <ComboBoxItem Content="BlueOnly" Tag="BlueOnly"/>
                                            <Separator/>
                                            <ComboBoxItem Content="SwapRB" Tag="SwapRB"/>
                                            <ComboBoxItem Content="TintRed" Tag="TintRed"/>
                                            <ComboBoxItem Content="TintCyan" Tag="TintCyan"/>
                                            <Separator/>
                                            <ComboBoxItem Content="BoxBlur3" Tag="BoxBlur3"/>
                                            <ComboBoxItem Content="GaussianBlur5" Tag="GaussianBlur5"/>
                                            <ComboBoxItem Content="Sharpen" Tag="Sharpen"/>
                                            <ComboBoxItem Content="Emboss" Tag="Emboss"/>
                                            <ComboBoxItem Content="SobelEdge" Tag="SobelEdge"/>
                                            <ComboBoxItem Content="ReverseSobelEdge" Tag="ReverseSobelEdge"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <Slider x:Name="FilterControlSlider" TickFrequency="1" IsSnapToTickEnabled="True" Maximum="255" Minimum="1" TickPlacement="Both" ValueChanged="FilterControlSlider_ValueChanged"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="G_Code" Header="G-code" Margin="0,0,0,10">
                        <Expander Header="Settings" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <StackPanel x:Name="XYFeed" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="XY Feed:" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="FeedXYBox" Width="148" Text="3000"/>
                                    <TextBlock Text="mm/min" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel x:Name="ZUp" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Z Up:" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ZUpBox" Width="173" Text="10"/>
                                    <TextBlock Text="mm" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel x:Name="ZDown" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Z Down:" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ZDownBox" Width="173" Text="2"/>
                                    <TextBlock Text="mm" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <CheckBox x:Name="OptimizeCheck" Content="Optimize stroke order"
                                      IsChecked="False" Margin="0,0,0,10"/>

                                <StackPanel x:Name="GCode_Export_Tools" Orientation="Horizontal">
                                    <Button x:Name="ExportBtn" Content="Export .gcode" Width="138" Margin="0,0,10,0" Click="ExportBtn_Click"/>
                                    <Button x:Name="CopyBtn" Content="Copy G-code" Width="145" Click="CopyBtn_Click"/>
                                </StackPanel>

                                <StackPanel x:Name="Start_End_Panel" Margin="10" Width="298" HorizontalAlignment="Left">
                                    <StackPanel x:Name="Start_Panel" Orientation="Horizontal" Margin="0,0,0,8" HorizontalAlignment="Left" Width="283">
                                        <TextBlock Width="33" VerticalAlignment="Top" Height="15"><Run Text="Start:"/><LineBreak/><Run/></TextBlock>
                                        <TextBox x:Name="StartGcodeBox" Width="250" Height="60" TextWrapping="Wrap"
                  AcceptsReturn="True"
                  VerticalScrollBarVisibility="Auto"
                  Text="G21 ; Set units to mm&#xA;G90 ; Absolute positioning&#xA;G94 ; Set feed rate mode to mm/min" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel x:Name="End_Panel" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="End:" Width="33" VerticalAlignment="Top"/>
                                        <TextBox x:Name="EndGcodeBox" Width="250" Height="60" TextWrapping="Wrap"
                  AcceptsReturn="True"
                  VerticalScrollBarVisibility="Auto"
                  Text="G0 Z10 ; Raise Z axis&#xA;G0 X0 Y0 ; Return to home" FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                        </Expander>
                    </GroupBox>



                    <GroupBox x:Name="Plotter" Header="Plotter (GRBL)" Margin="0,0,0,10">
                        <Expander Header="Settings" Height="302">
                            <StackPanel Margin="10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Port:" Width="90" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="PortCombo" Width="113"/>
                                    <Button Content="↻" Width="107" Margin="8,0,0,0" Click="RefreshPortsBtn_Click"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Baud:" Width="90" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="BaudCombo" Width="113">
                                        <ComboBoxItem Content="115200" IsSelected="True"/>
                                        <ComboBoxItem Content="250000"/>
                                    </ComboBox>
                                    <Button x:Name="ConnectBtn" Content="Connect" Width="107" Margin="8,0,0,0" Click="ConnectBtn_Click"/>
                                </StackPanel>

                                <WrapPanel Margin="0,0,0,10" Width="328">
                                    <Button Content="Auto Home ($H)" Width="178" Margin="0,0,8,8" Click="HomeBtn_Click"/>
                                    <Button Content="$X Unlock" Width="132" Margin="0,0,8,8" Click="UnlockBtn_Click"/>
                                    <Button Content="Reset" Width="178" Margin="0,0,8,8" Click="ResetBtn_Click"/>
                                    <Button x:Name="SendBtn" Content="Send G-code" Width="132" Margin="0,0,8,8" Click="SendBtn_Click"/>
                                    <Button x:Name="StopBtn" Content="Stop" Width="318" Margin="0,0,8,8" Click="StopBtn_Click"/>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Height="72">
                                    <TextBox x:Name="ManualCmdBox" Width="238" Margin="0,0,8,0"
                                         ToolTip="Send a single GRBL line, e.g. G0 X10 Y10" Height="57" VerticalAlignment="Top"/>
                                    <Button Content="Send" Width="72" Click="ManualSendBtn_Click" VerticalAlignment="Top"/>
                                </StackPanel>

                                <TextBlock x:Name="ConnStatusLabel" Margin="0,10,0,0" Foreground="#444"/>
                            </StackPanel>
                        </Expander>

                    </GroupBox>


                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- RIGHT PANEL -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="220"/>
            </Grid.RowDefinitions>

            <!-- CANVAS AREA -->
            <Border Grid.Row="0" Background="#EEE">
                <ScrollViewer x:Name="CanvasScroll"
              SizeChanged="CanvasScroll_SizeChanged"
              HorizontalScrollBarVisibility="Visible"
              VerticalScrollBarVisibility="Visible">
                    <Grid x:Name="CanvasHost" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="112*"/>
                            <RowDefinition Height="165*"/>
                        </Grid.RowDefinitions>
                        <Canvas x:Name="DrawCanvas" Background="Transparent"
                MouseWheel="DrawCanvas_MouseWheel"
                MouseDown="DrawCanvas_MouseDown"
                MouseUp="DrawCanvas_MouseUp"
                MouseMove="DrawCanvas_MouseMove"
                MouseLeave="DrawCanvas_MouseLeave"
                MouseRightButtonDown="DrawCanvas_MouseRightButtonDown"
                MouseLeftButtonDown="DrawCanvas_MouseLeftButtonDown"
                MouseLeftButtonUp="DrawCanvas_MouseLeftButtonUp"
                Grid.RowSpan="2"/>
                        <Canvas x:Name="RulerCanvas" IsHitTestVisible="False" Panel.ZIndex="10" Grid.RowSpan="2"/>
                    </Grid>
                </ScrollViewer>

            </Border>

            <!-- CONSOLE -->
            <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1,0,0,0" Background="#111">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="ConsoleBox" Grid.Row="1"
                             Background="#111" Foreground="#D7D7D7"
                             FontFamily="Consolas"
                             FontSize="12"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
