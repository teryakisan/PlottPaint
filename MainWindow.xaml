<Window x:Class="NVSPlotter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NVSPlotter" Width="1280" Height="820"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized" UseLayoutRounding="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="0,0,1,0" Background="#FAFAFA">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-1,0">
                <StackPanel Margin="10" Orientation="Vertical">

                    <TextBlock Text="NVSPlotter" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <GroupBox Header="Document" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Page:" Width="90" VerticalAlignment="Center"/>
                                <ComboBox x:Name="PagePresetCombo" Width="190" SelectionChanged="PagePresetCombo_SelectionChanged">
                                    <ComboBoxItem Content="A0 Portrait (841 x 1189 mm)" IsSelected="True"/>
                                    <ComboBoxItem Content="A0 Landscape (1189 x 841 mm)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Home Corner:" Width="90" VerticalAlignment="Center"/>
                                <ComboBox x:Name="HomeCornerCombo" Width="190">
                                    <ComboBoxItem Content="Top Right (common iDraw)" IsSelected="True"/>
                                    <ComboBoxItem Content="Top Left"/>
                                    <ComboBoxItem Content="Bottom Right"/>
                                    <ComboBoxItem Content="Bottom Left"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Tool:" Width="90" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ToolCombo" Width="190">
                                    <ComboBoxItem Content="Line" IsSelected="True"/>
                                    <ComboBoxItem Content="Pan (Middle Mouse also works)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Working area:" Width="90" VerticalAlignment="Center"/>
                                <Button x:Name="DefineWorkingAreaBtn" Content="Define" Width="90" Click="DefineWorkingAreaBtn_Click"/>
                                <Button x:Name="ClearWorkingAreaBtn" Content="Clear" Width="90" Margin="8,0,0,0" Click="ClearWorkingAreaBtn_Click"/>
                                
                            </StackPanel>

                            <StackPanel x:Name="status" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="WorkingAreaStatus" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#555"/>
                            </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Zoom:" Width="90" VerticalAlignment="Center"/>
                                <!-- NOTE: no ValueChanged handler here on purpose -->
                                <Slider x:Name="ZoomSlider" Minimum="0.1" Maximum="4.0" Value="1.0"
                                        Width="150" ValueChanged="ZoomSlider_ValueChanged"/>
                                <TextBlock x:Name="ZoomLabel" Width="60" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <WrapPanel Orientation="Horizontal" >
                                <Button x:Name="ClearBtn" Content="Clear" Width="55" Click="ClearBtn_Click"/>
                                <Button x:Name="UndoBtn" Content="Undo" Width="55" Click="UndoBtn_Click"/>
                                <Button x:Name="FitBtn" Content="Fit" Width="44" Click="FitBtn_Click"/>
                                <Button x:Name="RotateCanvasBtn" Content="Rotate 90°" Width="154" Click="RotateCanvasBtn_Click" Height="30"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="G-code" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="XY Feed:" Width="90" VerticalAlignment="Center"/>
                                <TextBox x:Name="FeedXYBox" Width="80" Text="3000"/>
                                <TextBlock Text="mm/min" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Z Up:" Width="90" VerticalAlignment="Center"/>
                                <TextBox x:Name="ZUpBox" Width="80" Text="10"/>
                                <TextBlock Text="mm" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Z Down:" Width="90" VerticalAlignment="Center"/>
                                <TextBox x:Name="ZDownBox" Width="80" Text="2"/>
                                <TextBlock Text="mm" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <CheckBox x:Name="OptimizeCheck" Content="Optimize stroke order (simple nearest-neighbor)"
                                      IsChecked="True" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ExportBtn" Content="Export .gcode" Width="140" Margin="0,0,10,0" Click="ExportBtn_Click"/>
                                <Button x:Name="CopyBtn" Content="Copy G-code" Width="140" Click="CopyBtn_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Plotter (GRBL)" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Port:" Width="90" VerticalAlignment="Center"/>
                                <ComboBox x:Name="PortCombo" Width="130"/>
                                <Button Content="↻" Width="36" Margin="8,0,0,0" Click="RefreshPortsBtn_Click"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Baud:" Width="90" VerticalAlignment="Center"/>
                                <ComboBox x:Name="BaudCombo" Width="130">
                                    <ComboBoxItem Content="115200" IsSelected="True"/>
                                    <ComboBoxItem Content="250000"/>
                                </ComboBox>
                                <Button x:Name="ConnectBtn" Content="Connect" Width="80" Margin="8,0,0,0" Click="ConnectBtn_Click"/>
                            </StackPanel>

                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="Auto Home ($H)" Width="120" Margin="0,0,8,8" Click="HomeBtn_Click"/>
                                <Button Content="$X Unlock" Width="95" Margin="0,0,8,8" Click="UnlockBtn_Click"/>
                                <Button Content="Reset" Width="95" Margin="0,0,8,8" Click="ResetBtn_Click"/>
                                <Button x:Name="SendBtn" Content="Send G-code" Width="120" Margin="0,0,8,8" Click="SendBtn_Click"/>
                                <Button x:Name="StopBtn" Content="Stop" Width="95" Margin="0,0,8,8" Click="StopBtn_Click"/>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="ManualCmdBox" Width="190" Margin="0,0,8,0"
                                         ToolTip="Send a single GRBL line, e.g. G0 X10 Y10"/>
                                <Button Content="Send" Width="70" Click="ManualSendBtn_Click"/>
                            </StackPanel>

                            <TextBlock x:Name="ConnStatusLabel" Margin="0,10,0,0" Foreground="#444"/>
                        </StackPanel>
                    </GroupBox>
                    

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- RIGHT PANEL -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="220"/>
            </Grid.RowDefinitions>

            <!-- CANVAS AREA -->
            <Border Grid.Row="0" Background="#EEE">
                <ScrollViewer x:Name="CanvasScroll"
              SizeChanged="CanvasScroll_SizeChanged"
              HorizontalScrollBarVisibility="Visible"
              VerticalScrollBarVisibility="Visible">
                    <Grid x:Name="CanvasHost" Background="Transparent">
                        <Canvas x:Name="DrawCanvas" Background="Transparent"
                MouseWheel="DrawCanvas_MouseWheel"
                MouseDown="DrawCanvas_MouseDown"
                MouseUp="DrawCanvas_MouseUp"
                MouseMove="DrawCanvas_MouseMove"
                MouseLeave="DrawCanvas_MouseLeave"
                MouseLeftButtonDown="DrawCanvas_MouseLeftButtonDown"
                MouseLeftButtonUp="DrawCanvas_MouseLeftButtonUp"/>
                        <Canvas x:Name="RulerCanvas" IsHitTestVisible="False" Panel.ZIndex="10"/>
                    </Grid>
                </ScrollViewer>

            </Border>

            <!-- CONSOLE -->
            <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1,0,0,0" Background="#111">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Console" Foreground="#AAA" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox x:Name="ConsoleBox" Grid.Row="1"
                             Background="#111" Foreground="#D7D7D7"
                             FontFamily="Consolas"
                             FontSize="12"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
