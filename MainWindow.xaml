<Window
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:gif="http://wpfanimatedgif.codeplex.com"
xmlns:Models="clr-namespace:NVSPlotter.Models" 
xmlns:local="clr-namespace:NVSPlotter"
xmlns:behaviors="clr-namespace:NVSPlotter.Behaviors"
x:Name="MainContainerWindow" x:Class="NVSPlotter.MainWindow"
Title="NVSPlotter" Width="1280" Height="807"
WindowStartupLocation="CenterScreen"
WindowState="Maximized" UseLayoutRounding="True"
PreviewKeyDown="Window_PreviewKeyDown" 
Style="{DynamicResource ThemedWindow}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Background="{DynamicResource SecondaryBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-1,0">
                <StackPanel Margin="10" Orientation="Vertical">

                    <GroupBox x:Name="Document" Header="Document" Margin="0,0,0,10">

                        <Expander Header="Settings" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <!-- Machine Settings Button -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="MachineSettingsBtn" Content="⚙ Machine Settings" Width="293" 
                                            Click="MachineSettingsBtn_Click" ToolTip="Configure plotter bed size, page dimensions, and home position"/>
                                </StackPanel>

                                <StackPanel x:Name="SafeMarginSetting" Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Safe Margin:" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SafeMarginBox" Width="60" TextChanged="SafeMarginBox_TextChanged"
                                             behaviors:DragValueBehavior.IsEnabled="True"
                                             behaviors:DragValueBehavior.Minimum="0"
                                             behaviors:DragValueBehavior.Maximum="500"
                                             behaviors:DragValueBehavior.Sensitivity="3"
                                             behaviors:DragValueBehavior.Step="1"
                                             ToolTip="Drag up/down to adjust value" Text="0"/>
                                    <TextBlock Text="mm" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ShowMarginOverlayCheck" Content="Show" IsChecked="True" 
                                              Margin="10,0,0,0" VerticalAlignment="Center" Click="ShowMarginOverlayCheck_Click"/>
                                </StackPanel>

                                <!-- Individual margin sides toggle -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="" Width="90"/>
                                    <CheckBox x:Name="UseIndividualMarginsCheck" Content="Individual sides" 
                                              VerticalAlignment="Center" Click="UseIndividualMarginsCheck_Click"
                                              ToolTip="Enable different margins for each side"/>
                                </StackPanel>

                                <!-- Individual margin controls (collapsed by default) -->
                                <StackPanel x:Name="IndividualMarginsPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                    <Grid Margin="90,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Left margin -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="L:" VerticalAlignment="Center" Margin="0,0,2,4"/>
                                        <TextBox x:Name="MarginLeftBox" Grid.Row="0" Grid.Column="1" Width="35" Text="50" 
                                                 TextChanged="MarginLeftBox_TextChanged" Margin="0,0,8,4"
                                                 behaviors:DragValueBehavior.IsEnabled="True"
                                                 behaviors:DragValueBehavior.Minimum="0"
                                                 behaviors:DragValueBehavior.Maximum="500"
                                                 behaviors:DragValueBehavior.Sensitivity="3"
                                                 behaviors:DragValueBehavior.Step="1"
                                                 ToolTip="Drag up/down to adjust"/>

                                        <!-- Top margin -->
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="T:" VerticalAlignment="Center" Margin="0,0,2,4"/>
                                        <TextBox x:Name="MarginTopBox" Grid.Row="0" Grid.Column="3" Width="35" Text="50" 
                                                 TextChanged="MarginTopBox_TextChanged" Margin="0,0,0,4"
                                                 behaviors:DragValueBehavior.IsEnabled="True"
                                                 behaviors:DragValueBehavior.Minimum="0"
                                                 behaviors:DragValueBehavior.Maximum="500"
                                                 behaviors:DragValueBehavior.Sensitivity="3"
                                                 behaviors:DragValueBehavior.Step="1"
                                                 ToolTip="Drag up/down to adjust"/>

                                        <!-- Right margin -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="R:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <TextBox x:Name="MarginRightBox" Grid.Row="1" Grid.Column="1" Width="35" Text="50" 
                                                 TextChanged="MarginRightBox_TextChanged" Margin="0,0,8,0"
                                                 behaviors:DragValueBehavior.IsEnabled="True"
                                                 behaviors:DragValueBehavior.Minimum="0"
                                                 behaviors:DragValueBehavior.Maximum="500"
                                                 behaviors:DragValueBehavior.Sensitivity="3"
                                                 behaviors:DragValueBehavior.Step="1"
                                                 ToolTip="Drag up/down to adjust"/>

                                        <!-- Bottom margin -->
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="B:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <TextBox x:Name="MarginBottomBox" Grid.Row="1" Grid.Column="3" Width="35" Text="50" 
                                                 TextChanged="MarginBottomBox_TextChanged"
                                                 behaviors:DragValueBehavior.IsEnabled="True"
                                                 behaviors:DragValueBehavior.Minimum="0"
                                                 behaviors:DragValueBehavior.Maximum="500"
                                                 behaviors:DragValueBehavior.Sensitivity="3"
                                                 behaviors:DragValueBehavior.Step="1"
                                                 ToolTip="Drag up/down to adjust"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel x:Name="Tools" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                                    <!-- Tool selection moved to floating Tools panel -->
                                    <TextBlock Text="Tool:" Width="110" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ToolCombo" Width="203" SelectedValuePath="Tag" SelectionChanged="ToolCombo_SelectionChanged">
                                        <ComboBoxItem Content="Paint Well Tool" Tag="PaintWell"  IsSelected="True"/>
                                        <ComboBoxItem Content="Line" Tag="Line"/>
                                        <ComboBoxItem Content="Pan (Middle Mouse also works)" Tag="Pan"/>
                                        <ComboBoxItem Content="Zoom Tool" Tag="Zoom"/>
                                        <ComboBoxItem Content="Rectangle Tool" Tag="Rectangle"/>
                                        <ComboBoxItem Content="Circle Tool" Tag="Circle"/>
                                        <ComboBoxItem Content="Polyline Tool" Tag="Polyline"/>
                                        <ComboBoxItem Content="Bezier Tool" Tag="Bezier"/>
                                        <ComboBoxItem Content="Erase Tool" Tag="Erase"/>
                                        <ComboBoxItem Content="Measurement Tool" Tag="Measure"/>
                                        <ComboBoxItem Content="Guides / Grid Tool" Tag="Guides"/>
                                        <ComboBoxItem Content="Text / Annotation Tool" Tag="Text"/>
                                        <ComboBoxItem Content="Selection / Transform Tool" Tag="Select"/>
                                        <ComboBoxItem Content="Crop / Mask Tool" Tag="Crop"/>
                                        <ComboBoxItem Content="Image Alignment Tool" Tag="ImageAlign"/>

                                    </ComboBox>
                                </StackPanel>

                                <StackPanel x:Name="SnapSettings" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Snap:" Width="68" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="SnapEnabledCheck" Content="Endpoints" IsChecked="True" VerticalAlignment="Center"/>
                                    <TextBlock Text="Radius:" Margin="15,0,5,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SnapRadiusBox" Width="40" Text="5" VerticalAlignment="Center" TextChanged="MarginTopBox_TextChanged" Margin="0,0,0,4"
behaviors:DragValueBehavior.IsEnabled="True"
behaviors:DragValueBehavior.Minimum="0"
behaviors:DragValueBehavior.Maximum="500"
behaviors:DragValueBehavior.Sensitivity="3"
behaviors:DragValueBehavior.Step="1"/>
                                    <TextBlock Text="mm" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel x:Name="GridSettings" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Grid:" Width="68" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ShowGridCheck" Content="Show" IsChecked="True" VerticalAlignment="Center" Click="ShowGridCheck_Click"/>
                                    <CheckBox x:Name="SnapToGridCheck" Content="Snap" IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Text="Size:" Margin="10,0,5,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="GridSpacingBox" Width="35" Text="5" VerticalAlignment="Center" TextChanged="GridSpacingBox_TextChanged" Margin="0,0,0,4"
behaviors:DragValueBehavior.IsEnabled="True"
behaviors:DragValueBehavior.Minimum="0"
behaviors:DragValueBehavior.Maximum="500"
behaviors:DragValueBehavior.Sensitivity="3"
behaviors:DragValueBehavior.Step="1"/>
                                    <TextBlock Text="mm" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel x:Name="MeasurementOut" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Measure:" Width="90" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MeasurementStatus" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#555" Text="—"/>
                                </StackPanel>

                                <!-- Paint Canvas Area -->
                                <StackPanel x:Name="PaintCanvasArea" Orientation="Vertical" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Paint Canvas:" Width="90" VerticalAlignment="Center"/>
                                        <Button x:Name="DefinePaintCanvasBtn" Content="Define" Width="60" Click="DefineWorkingAreaBtn_Click" 
                                                ToolTip="Click and drag on canvas to define paint canvas area"/>
                                        <Button x:Name="ClearPaintCanvasBtn" Content="Clear" Width="60" Margin="4,0,0,0" Click="ClearWorkingAreaBtn_Click"/>
                                    </StackPanel>

                                    <!-- Manual Width/Height inputs -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="" Width="90"/>
                                        <TextBlock Text="W:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <TextBox x:Name="PaintCanvasWidthBox" Width="50" Text="0"
                                                 TextChanged="PaintCanvasWidthBox_TextChanged"
                                                 behaviors:DragValueBehavior.IsEnabled="True"
                                                 behaviors:DragValueBehavior.Minimum="0"
                                                 behaviors:DragValueBehavior.Maximum="2000"
                                                 behaviors:DragValueBehavior.Sensitivity="2"
                                                 behaviors:DragValueBehavior.Step="1"
                                                 ToolTip="Paint canvas width (drag or click to edit)"/>
                                        <TextBlock Text="H:" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                        <TextBox x:Name="PaintCanvasHeightBox" Width="50" Text="0"
                                                 TextChanged="PaintCanvasHeightBox_TextChanged"
                                                 behaviors:DragValueBehavior.IsEnabled="True"
                                                 behaviors:DragValueBehavior.Minimum="0"
                                                 behaviors:DragValueBehavior.Maximum="2000"
                                                 behaviors:DragValueBehavior.Sensitivity="2"
                                                 behaviors:DragValueBehavior.Step="1"
                                                 ToolTip="Paint canvas height (drag or click to edit)"/>
                                        <TextBlock Text="mm" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>

                                    <!-- Popular Canvas Sizes -->
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                            CornerRadius="4" Padding="6" Margin="0,4,0,4"
                                            Background="{DynamicResource TertiaryBackgroundBrush}">
                                        <StackPanel>
                                            <TextBlock Text="Popular Sizes:" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <UniformGrid Rows="4" Columns="4" HorizontalAlignment="Stretch">
                                                <!-- Row 1: A-series paper sizes -->
                                                <Button Content="A4" Height="24" Margin="2" FontSize="10"
                                                        Tag="210,297" Click="CanvasSizePreset_Click"
                                                        ToolTip="A4: 210 × 297 mm"/>
                                                <Button Content="A3" Height="24" Margin="2" FontSize="10"
                                                        Tag="297,420" Click="CanvasSizePreset_Click"
                                                        ToolTip="A3: 297 × 420 mm"/>
                                                <Button Content="A2" Height="24" Margin="2" FontSize="10"
                                                        Tag="420,594" Click="CanvasSizePreset_Click"
                                                        ToolTip="A2: 420 × 594 mm"/>
                                                <Button Content="A1" Height="24" Margin="2" FontSize="10"
                                                        Tag="594,841" Click="CanvasSizePreset_Click"
                                                        ToolTip="A1: 594 × 841 mm"/>
                                                <!-- Row 2: A0, US Paper, Square -->
                                                <Button Content="A0" Height="24" Margin="2" FontSize="10"
                                                        Tag="841,1189" Click="CanvasSizePreset_Click"
                                                        ToolTip="A0: 841 × 1189 mm"/>
                                                <Button Content="Letter" Height="24" Margin="2" FontSize="10"
                                                        Tag="216,279" Click="CanvasSizePreset_Click"
                                                        ToolTip="US Letter: 216 × 279 mm (8.5 × 11 in)"/>
                                                <Button Content="Legal" Height="24" Margin="2" FontSize="10"
                                                        Tag="216,356" Click="CanvasSizePreset_Click"
                                                        ToolTip="US Legal: 216 × 356 mm (8.5 × 14 in)"/>
                                                <Button Content="□12&quot;" Height="24" Margin="2" FontSize="10"
                                                        Tag="305,305" Click="CanvasSizePreset_Click"
                                                        ToolTip="12 × 12 inches: 305 × 305 mm (square)"/>
                                                <!-- Row 3: Common art canvas sizes -->
                                                <Button Content="8×10" Height="24" Margin="2" FontSize="10"
                                                        Tag="203,254" Click="CanvasSizePreset_Click"
                                                        ToolTip="8 × 10 inches: 203 × 254 mm"/>
                                                <Button Content="11×14" Height="24" Margin="2" FontSize="10"
                                                        Tag="279,356" Click="CanvasSizePreset_Click"
                                                        ToolTip="11 × 14 inches: 279 × 356 mm"/>
                                                <Button Content="16×20" Height="24" Margin="2" FontSize="10"
                                                        Tag="406,508" Click="CanvasSizePreset_Click"
                                                        ToolTip="16 × 20 inches: 406 × 508 mm"/>
                                                <Button Content="□20&quot;" Height="24" Margin="2" FontSize="10"
                                                        Tag="508,508" Click="CanvasSizePreset_Click"
                                                        ToolTip="20 × 20 inches: 508 × 508 mm (square)"/>
                                                <!-- Row 4: Larger canvas sizes -->
                                                <Button Content="18×24" Height="24" Margin="2" FontSize="10"
                                                        Tag="457,610" Click="CanvasSizePreset_Click"
                                                        ToolTip="18 × 24 inches: 457 × 610 mm"/>
                                                <Button Content="24×36" Height="24" Margin="2" FontSize="10"
                                                        Tag="610,914" Click="CanvasSizePreset_Click"
                                                        ToolTip="24 × 36 inches: 610 × 914 mm"/>
                                                <Button Content="30×40" Height="24" Margin="2" FontSize="10"
                                                        Tag="762,1016" Click="CanvasSizePreset_Click"
                                                        ToolTip="30 × 40 inches: 762 × 1016 mm"/>
                                                <Button Content="36×48" Height="24" Margin="2" FontSize="10"
                                                        Tag="914,1219" Click="CanvasSizePreset_Click"
                                                        ToolTip="36 × 48 inches: 914 × 1219 mm"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Lock margins to canvas checkbox -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="" Width="90"/>
                                        <CheckBox x:Name="LockMarginsToCanvasCheck" Content="Lock margins to canvas" 
                                                  VerticalAlignment="Center" Click="LockMarginsToCanvasCheck_Click"
                                                  ToolTip="When enabled, safe margins are calculated from paint canvas edges instead of plotter bed"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel x:Name="status" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock x:Name="PaintCanvasStatus" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#555"/>
                                </StackPanel>
                                <StackPanel x:Name="RefZoom" Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Zoom:" Width="90" VerticalAlignment="Center"/>
                                    <!-- NOTE: no ValueChanged handler here on purpose -->
                                    <Slider x:Name="ZoomSlider" Minimum="0.1" Maximum="4.0" Value="0.6"
                                            Width="150" ValueChanged="ZoomSlider_ValueChanged"/>
                                    <TextBlock x:Name="ZoomLabel" Width="60" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <WrapPanel x:Name="RefCUFR90" Orientation="Horizontal" >
                                    <Button x:Name="ClearBtn" Content="Clear" Width="55" Click="ClearBtn_Click"/>
                                    <Button x:Name="UndoBtn" Content="Undo" Width="55" Click="UndoBtn_Click"/>
                                    <Button x:Name="FitBtn" Content="Fit" Width="77" Click="FitBtn_Click"/>
                                    <Button x:Name="RotateCanvasBtn" Content="Rotate 90°" Width="101" Click="RotateCanvasBtn_Click" Height="30"/>
                                </WrapPanel>


                            </StackPanel>
                        </Expander>

                    </GroupBox>
                    <!-- PAINT WELLS / PAINTING MODE -->
                    <GroupBox x:Name="PaintWellsGroup" Header="🎨 Painting Mode" Margin="0,0,0,10">
                        <Expander Header="Paint Wells" IsExpanded="True">
                            <StackPanel Margin="10">
                                <!-- Enable/Disable Painting Mode -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox x:Name="PaintModeEnabledCheck" Content="Enable Painting Mode" 
                               IsChecked="True" VerticalAlignment="Center" 
                               Click="PaintModeEnabledCheck_Click"/>
                                </StackPanel>

                                <!-- Paint Mode Controls Container - disabled when paint mode is off -->
                                <StackPanel x:Name="PaintModeControlsPanel">
                                    <!-- Auto Wash/Wipe on Color Change -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <CheckBox x:Name="AutoWashWipeCheck" Content="Auto Wash/Wipe on color change" 
                                   IsChecked="True" VerticalAlignment="Center" 
                                   ToolTip="Automatically rinse and wipe brush when changing colors"/>
                                    </StackPanel>

                                    <!-- Paint Wells Grid -->
                                    <TextBlock Text="Paint Wells:" Margin="0,5,0,3" FontWeight="SemiBold"/>
                                    <ItemsControl x:Name="PaintWellsGrid" Margin="0,0,0,8">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Outer border for selection highlight with glow effect -->
                                                <Border x:Name="SelectionHighlight" 
                                                        Width="42" Height="42" Margin="3" 
                                                        BorderThickness="0" CornerRadius="6"
                                                        Background="Transparent">
                                                    <Border x:Name="WellChip" Width="36" Height="36"
                                                            BorderThickness="2" CornerRadius="4" Cursor="Hand"
                                                            MouseLeftButtonDown="PaintWellChip_MouseLeftButtonDown"
                                                            Tag="{Binding}"
                                                            BorderBrush="{Binding Color, Converter={StaticResource ColorToBrushConverter}}"
                                                            Background="{Binding Color, Converter={StaticResource ColorToBrushConverter}, ConverterParameter=0.7}">
                                                        <Border.ToolTip>
                                                            <StackPanel MaxWidth="200">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"/>
                                                                <Separator Margin="0,3"/>
                                                                <TextBlock Text="{Binding DipDepth, StringFormat='Dip Depth: {0:0.#} mm'}" FontSize="11"/>
                                                                <TextBlock Text="{Binding DwellTimeMs, StringFormat='Dwell Time: {0} ms'}" FontSize="11"/>
                                                                <TextBlock FontSize="11">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding StringFormat="Refresh: {0:0}-{1:0} mm">
                                                                            <Binding Path="RefreshDistanceMinMm"/>
                                                                            <Binding Path="RefreshDistanceMaxMm"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                                <TextBlock FontSize="11">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding StringFormat="Position: ({0:0}, {1:0})">
                                                                            <Binding Path="Bounds.Left"/>
                                                                            <Binding Path="Bounds.Top"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                                <TextBlock FontSize="11">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding StringFormat="Size: {0:0} x {1:0} mm">
                                                                            <Binding Path="Bounds.Width"/>
                                                                            <Binding Path="Bounds.Height"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                                <Separator Margin="0,3"/>
                                                                <TextBlock Text="Click to select" FontSize="10" Foreground="Gray" FontStyle="Italic"/>
                                                            </StackPanel>
                                                        </Border.ToolTip>
                                                        <!-- Show first letter of name as label -->
                                                        <TextBlock Text="{Binding Name, Converter={StaticResource FirstLetterConverter}}" 
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   FontWeight="Bold" FontSize="14"
                                                                   Foreground="White">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect ShadowDepth="1" BlurRadius="2" Color="Black" Opacity="0.7"/>
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                    </Border>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Hidden ListBox for backward compatibility with selection logic -->
                                    <ListBox x:Name="PaintWellsList" Visibility="Collapsed"
                                             SelectionChanged="PaintWellsList_SelectionChanged"/>

                                    <!-- Paint Well Actions -->
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button x:Name="ClearActivePaintWellBtn" Content="None" Width="50" Margin="0,0,5,0" 
                                                Click="ClearActivePaintWell_Click" ToolTip="Clear active paint selection (use black)"/>
                                        <Button x:Name="AddPaintWellBtn" Content="Add Well" Width="70" Margin="0,0,5,0" 
                                        Click="AddPaintWellBtn_Click" ToolTip="Create a new paint well at the center of the canvas"/>
                                        <Button x:Name="RemovePaintWellBtn" Content="Remove" Width="60" Margin="0,0,5,0" 
                                 Click="RemovePaintWellBtn_Click"/>
                                        <Button x:Name="ClearPaintWellsBtn" Content="Clear All" Width="60" 
                                 Click="ClearPaintWellsBtn_Click"/>
                                    </WrapPanel>

                                    <!-- Quick Setup -->
                                    <Button x:Name="QuickSetupPaintWellsBtn" Content="🎨 Quick Setup" 
                             Margin="0,0,0,8" Click="QuickSetupPaintWellsBtn_Click"
                             ToolTip="Create Red, Green, Blue, Wash (black), and Wipe (gray) paint wells automatically"/>

                                    <!-- Selected Well Properties -->
                                    <Border BorderBrush="#CCC" BorderThickness="1" Padding="8" Margin="0,5,0,0"
                             Visibility="{Binding ElementName=PaintWellsList, Path=SelectedItem, Converter={StaticResource NullToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="Selected Well Properties:" FontWeight="SemiBold" Margin="0,0,0,5"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="Name:" Width="70" VerticalAlignment="Center"/>
                                                <TextBox x:Name="PaintWellNameBox" Width="150" 
                                          TextChanged="PaintWellNameBox_TextChanged"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="Color:" Width="70" VerticalAlignment="Center"/>
                                                <Rectangle x:Name="PaintWellColorPreview" Width="24" Height="24" 
                                            Stroke="Gray" StrokeThickness="1" Margin="0,0,8,0"
                                            MouseLeftButtonDown="PaintWellColorPreview_Click" Cursor="Hand"/>
                                                <Button Content="Pick Color" Width="80" Click="PaintWellColorPreview_Click"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="Dip Depth:" Width="70" VerticalAlignment="Center"/>
                                                <TextBox x:Name="PaintWellDipDepthBox" Width="60" 
                                          TextChanged="PaintWellDipDepthBox_TextChanged"/>
                                                <TextBlock Text="mm" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="Dwell Time:" Width="70" VerticalAlignment="Center"/>
                                                <TextBox x:Name="PaintWellDwellBox" Width="60" 
                                          TextChanged="PaintWellDwellBox_TextChanged"/>
                                                <TextBlock Text="ms" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="Refresh:" Width="70" VerticalAlignment="Center"/>
                                                <TextBox x:Name="PaintWellRefreshMinBox" Width="40" 
                                          TextChanged="PaintWellRefreshMinBox_TextChanged"
                                          ToolTip="Minimum distance before paint refresh"/>
                                                <TextBlock Text="-" Margin="3,0,3,0" VerticalAlignment="Center"/>
                                                <TextBox x:Name="PaintWellRefreshMaxBox" Width="40" 
                                          TextChanged="PaintWellRefreshMaxBox_TextChanged"
                                          ToolTip="Maximum distance before paint refresh"/>
                                                <TextBlock Text="mm" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="10"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </GroupBox>
                    <GroupBox x:Name="ReferenceImage" Header="Reference Image" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel x:Name="ReferenceImagePanel">
                            <Expander x:Name="ReferenceExpander" Header="Settings">
                                <local:ReferenceImageView x:Name="ReferenceView"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="G_Code" Header="G-code" Margin="0,0,0,10">
                        <Expander Header="Settings" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <StackPanel x:Name="XYFeed" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="XY Feed:" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="FeedXYBox" Width="148" Text="3000&#xA;" Height="22"
                                             TextChanged="MarginTopBox_TextChanged" Margin="0,0,0,4"
                                            behaviors:DragValueBehavior.IsEnabled="True"
                                            behaviors:DragValueBehavior.Minimum="10"
                                            behaviors:DragValueBehavior.Maximum="20000"
                                            behaviors:DragValueBehavior.Sensitivity="10"
                                            behaviors:DragValueBehavior.Step="1"    />
                                    <TextBlock Text="mm/min" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel x:Name="ZUp" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Z Up:" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ZUpBox" Width="173" Text="10" TextChanged="MarginTopBox_TextChanged" Margin="0,0,0,4"
behaviors:DragValueBehavior.IsEnabled="True"
behaviors:DragValueBehavior.Minimum="0"
behaviors:DragValueBehavior.Maximum="10"
behaviors:DragValueBehavior.Sensitivity="3"
behaviors:DragValueBehavior.Step="1"/>
                                    <TextBlock Text="mm" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel x:Name="ZDown" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Z Down:" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ZDownBox" Width="173" Text="2" TextChanged="MarginTopBox_TextChanged" Margin="0,0,0,4"
behaviors:DragValueBehavior.IsEnabled="True"
behaviors:DragValueBehavior.Minimum="0"
behaviors:DragValueBehavior.Maximum="10"
behaviors:DragValueBehavior.Sensitivity="3"
behaviors:DragValueBehavior.Step="1"/>
                                    <TextBlock Text="mm" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <CheckBox x:Name="OptimizeCheck" Content="Optimize stroke order"
                                      IsChecked="False" Margin="0,0,0,10"/>

                                <StackPanel x:Name="GCode_Export_Tools" Orientation="Horizontal">
                                    <Button x:Name="ExportBtn" Content="Export .gcode" Width="138" Margin="0,0,10,0" Click="ExportBtn_Click"/>
                                    <Button x:Name="CopyBtn" Content="Copy G-code" Width="145" Click="CopyBtn_Click"/>
                                </StackPanel>

                                <StackPanel x:Name="Start_End_Panel" Margin="10" Width="298" HorizontalAlignment="Left">
                                    <StackPanel x:Name="Start_Panel" Orientation="Horizontal" Margin="0,0,0,8" HorizontalAlignment="Left" Width="283">
                                        <TextBlock Width="33" VerticalAlignment="Top" Height="15"><Run Text="Start:"/><LineBreak/><Run/></TextBlock>
                                        <TextBox x:Name="StartGcodeBox" Width="250" Height="60" TextWrapping="Wrap"
                  AcceptsReturn="True"
                  VerticalScrollBarVisibility="Auto"
                  Text="G21 ; Set units to mm&#xA;G90 ; Absolute positioning&#xA;G94 ; Set feed rate mode to mm/min" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel x:Name="End_Panel" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="End:" Width="33" VerticalAlignment="Top"/>
                                        <TextBox x:Name="EndGcodeBox" Width="250" Height="60" TextWrapping="Wrap"
                  AcceptsReturn="True"
                  VerticalScrollBarVisibility="Auto"
                  Text="G0 Z10 ; Raise Z axis&#xA;G0 X0 Y0 ; Return to home" FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                        </Expander>
                    </GroupBox>



                    <GroupBox x:Name="Plotter" Header="Plotter (GRBL)" Margin="0,0,0,10">
                        <Expander Header="Settings">
                            <StackPanel Margin="10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Port:" Width="90" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="PortCombo" Width="113"/>
                                    <Button Content="↻" Width="82" Margin="8,0,0,0" Click="RefreshPortsBtn_Click"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Baud:" Width="90" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="BaudCombo" Width="113">
                                        <ComboBoxItem Content="115200" IsSelected="True"/>
                                        <ComboBoxItem Content="250000"/>
                                    </ComboBox>
                                    <Button x:Name="ConnectBtn" Content="Connect" Width="82" Margin="8,0,0,0" Click="ConnectBtn_Click"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <CheckBox x:Name="AutoHomeOnConnectCheck" Content="Auto Home on Connect" 
                                              IsChecked="True" VerticalAlignment="Center"
                                              ToolTip="Automatically home the plotter after connecting"/>
                                </StackPanel>

                                <WrapPanel Margin="0,0,0,10" Width="328">
                                    <Button Content="Auto Home ($H)" Width="178" Margin="0,0,8,8" Click="HomeBtn_Click"/>
                                    <Button Content="$X Unlock" Width="107" Margin="0,0,8,8" Click="UnlockBtn_Click"/>
                                    <Button Content="Reset" Width="178" Margin="0,0,8,8" Click="ResetBtn_Click"/>
                                    <Button x:Name="SendBtn" Content="Send G-code" Width="107" Margin="0,0,8,8" Click="SendBtn_Click"/>
                                    <Button x:Name="StopBtn" Content="Stop" Width="293" Margin="0,0,8,8" Click="StopBtn_Click"/>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Height="96">
                                    <TextBox x:Name="ManualCmdBox" Width="238" Margin="0,0,8,0"
                                         ToolTip="Send a single GRBL line, e.g. G0 X10 Y10" Height="91" VerticalAlignment="Top"/>
                                    <Button Content="Send" Width="42" Click="ManualSendBtn_Click" Height="24"/>
                                </StackPanel>

                                <TextBlock x:Name="ConnStatusLabel" Margin="0,10,0,0" Foreground="#444"/>
                            </StackPanel>
                        </Expander>

                    </GroupBox>




                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- RIGHT PANEL -->
        <Grid Grid.Column="1">
            <!-- CANVAS AREA -->
            <Border Background="{DynamicResource CanvasBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <DockPanel Grid.Row="0" Background="{DynamicResource TertiaryBackgroundBrush}" Height="30" LastChildFill="False">

                        <!-- Left side buttons -->
                        <Button x:Name="NewProjectBtn" DockPanel.Dock="Left" Content="📄 New" Width="60" Margin="5,2" Click="NewProjectBtn_Click" ToolTip="New Project (Ctrl+N)"/>
                        <Button x:Name="OpenProjectBtn" DockPanel.Dock="Left" Content="📂 Open" Width="85" Margin="0,2,5,2" Click="OpenProjectBtn_Click" ToolTip="Open Project (Ctrl+O)"/>
                        <Button x:Name="SaveProjectBtn" DockPanel.Dock="Left" Content="💾 Save" Width="77" Margin="0,2,5,2" Click="SaveProjectBtn_Click" ToolTip="Save Project (Ctrl+S)"/>
                        <Button x:Name="SaveAsProjectBtn" DockPanel.Dock="Left" Content="Save As" Width="80" Margin="0,2,5,2" Click="SaveAsProjectBtn_Click" ToolTip="Save Project As (Ctrl+Shift+S)"/>
                        <Separator DockPanel.Dock="Left" Width="1" Background="{DynamicResource BorderBrush}" Margin="5,4"/>
                        <Button x:Name="ShowConsoleBtn" DockPanel.Dock="Left" Content="📋 Console" Width="87" Margin="5,2" Click="ShowConsoleBtn_Click" ToolTip="Show/Hide Console Window"/>
                        <Button x:Name="ReferenceImageBtn" DockPanel.Dock="Left" Content="🖼 Reference" Width="95" Margin="5,2" Click="ReferenceImageBtn_Click" ToolTip="Open Reference Image Window"/>
                        <Button x:Name="BrushProfilesBtn" DockPanel.Dock="Left" Content="🖌 Profiles" Width="95" Margin="5,2" Click="BrushProfilesBtn_Click" ToolTip="Open Brush Stroke Profiles"/>
                        <Button x:Name="GcodeVisualizerBtn" DockPanel.Dock="Left" Content="🔍 Path Debug" Width="95" Margin="5,2" Click="GcodeVisualizerBtn_Click" ToolTip="Open G-code Path Visualizer for debugging"/>

                        <!-- Theme Toggle Switch - docked to the right -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,10,0">
                            <TextBlock Text="☀" FontSize="12" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" Margin="0,0,4,0" 
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <ToggleButton x:Name="ThemeToggle" 
                                          Style="{StaticResource ThemeToggleSwitchStyle}"
                                          Click="ThemeToggle_Click"
                                          ToolTip="Toggle Dark/Light Mode"/>
                            <TextBlock Text="🌙" FontSize="12" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer x:Name="CanvasScroll" Grid.Row="1"
                      SizeChanged="CanvasScroll_SizeChanged"
                      HorizontalScrollBarVisibility="Visible"
                      VerticalScrollBarVisibility="Visible"
                      Padding="40,0,0,0">
                        <Grid x:Name="CanvasHost" Background="Transparent">
                            <Canvas x:Name="DrawCanvas" Background="Transparent"
                    MouseWheel="DrawCanvas_MouseWheel"
                    MouseDown="DrawCanvas_MouseDown"
                    MouseUp="DrawCanvas_MouseUp"
                    MouseMove="DrawCanvas_MouseMove"
                    MouseLeave="DrawCanvas_MouseLeave"
                    MouseRightButtonDown="DrawCanvas_MouseRightButtonDown"
                    MouseLeftButtonDown="DrawCanvas_MouseLeftButtonDown"
                    MouseLeftButtonUp="DrawCanvas_MouseLeftButtonUp">
                                <Canvas.ContextMenu>
                                    <ContextMenu x:Name="CanvasContextMenu" Opened="CanvasContextMenu_Opened">
                                        <!-- Edit operations -->
                                        <MenuItem x:Name="CutMenuItem" Header="_Cut" InputGestureText="Ctrl+X" Click="CutMenuItem_Click"/>
                                        <MenuItem x:Name="CopyMenuItem" Header="_Copy" InputGestureText="Ctrl+C" Click="CopyMenuItem_Click"/>
                                        <MenuItem x:Name="PasteMenuItem" Header="_Paste" InputGestureText="Ctrl+V" Click="PasteMenuItem_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="DeleteMenuItem" Header="_Delete" InputGestureText="Del" Click="DeleteMenuItem_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="SelectAllMenuItem" Header="Select _All" InputGestureText="Ctrl+A" Click="SelectAllMenuItem_Click"/>
                                        <MenuItem x:Name="DeselectMenuItem" Header="D_eselect" InputGestureText="Esc" Click="DeselectMenuItem_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="GroupMenuItem" Header="_Group" InputGestureText="Ctrl+G" Click="GroupMenuItem_Click"/>
                                        <MenuItem x:Name="UngroupMenuItem" Header="_Ungroup" InputGestureText="Ctrl+Shift+G" Click="UngroupMenuItem_Click"/>
                                        <MenuItem x:Name="SeparateFromGroupMenuItem" Header="Se_parate from Group" Click="SeparateFromGroupMenuItem_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="SubdivideMenuItem" Header="Su_bdivide..." Click="SubdivideMenuItem_Click" 
                                                      ToolTip="Drag up/down to add or remove intermediate points along the stroke"/>
                                            <MenuItem x:Name="ToggleIntermediatePointsMenuItem" Header="Show _Intermediate Points" IsCheckable="True" Click="ToggleIntermediatePointsMenuItem_Click"/>
                                            <Separator x:Name="BrushProfileSeparator"/>
                                            <MenuItem x:Name="BrushProfilesMenuItem" Header="🖌 Brush _Profiles" 
                                                      ToolTip="Select brush profiles to apply to selected strokes. When plotting, one profile is randomly selected from enabled profiles.">
                                                <!-- Dynamic items added in code-behind -->
                                            </MenuItem>
                                        </ContextMenu>
                                </Canvas.ContextMenu>
                            </Canvas>
                            <Canvas x:Name="RulerCanvas" IsHitTestVisible="False"  Panel.ZIndex="10"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
